{
  "name": "material-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:kitchen": "VITE_APP=kitchen vite",
    "dev:bathroom": "VITE_APP=bathroom vite",
    "dev:fencing": "VITE_APP=fencing vite",
    "build": "vite build",
    "build:kitchen": "VITE_APP=kitchen vite build",
    "build:bathroom": "VITE_APP=bathroom vite build",
    "build:fencing": "VITE_APP=fencing vite build",
    "preview": "vite preview",
    "assets:fetch": "node scripts/fetchAssets.mjs",
    "validation:fetch": "node scripts/fetchValidation.mjs",
    "validation:find": "node --env-file-if-exists=.env scripts/findValidationPhotos.mjs",
    "validation:score": "VALIDATION=1 playwright test tests/e2e/validation-score.spec.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "scenes:fetch": "node scripts/fetchScenes.mjs",
    "scenes:bake": "BAKE=1 playwright test tests/e2e/scene-bake.spec.ts",
    "scenes:refine": "esbuild scripts/sceneRefine.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/scene-refine.mjs --log-level=warning && node node_modules/.cache/scene-refine.mjs",
    "scenes:qa": "esbuild scripts/sceneQa.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/scene-qa.mjs --log-level=warning && node node_modules/.cache/scene-qa.mjs",
    "scenes:light": "esbuild scripts/lightRefine.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/light-refine.mjs --log-level=warning && node node_modules/.cache/light-refine.mjs",
    "scenes:intrinsic:setup": "uv venv --python 3.12 scripts/intrinsic/.venv && uv pip install --python scripts/intrinsic/.venv/bin/python -r scripts/intrinsic/requirements.txt",
    "scenes:intrinsic": "scripts/intrinsic/.venv/bin/python scripts/intrinsic/bake.py",
    "materials:build": "node scripts/buildStudioTextures.mjs",
    "finishes:fromref": "esbuild scripts/paintFromReference.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/paint-from-ref.mjs --log-level=warning && node node_modules/.cache/paint-from-ref.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
