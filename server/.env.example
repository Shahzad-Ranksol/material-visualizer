DATABASE_URL="mysql://app:app@localhost:3306/material_visualizer"
JWT_SECRET="change-me-in-production"
PORT=4000

# Only consumed once, by `npm run prisma:seed:admin` — not read at server boot.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Platform Admin"

# Object storage for uploaded images (S3-compatible). Local dev uses MinIO:
#   MINIO_ROOT_USER=minioadmin MINIO_ROOT_PASSWORD=minioadmin minio server ~/minio-data --address :9000 --console-address :9001
# Production (AWS S3): leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false, use an IAM user
# limited to this bucket, and point S3_PUBLIC_URL at the bucket or its CloudFront domain.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="material-visualizer"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/material-visualizer"
# Comma-separated origins allowed to load images (applied by `npm run storage:setup` on AWS)
S3_CORS_ORIGINS="http://localhost:3000"
